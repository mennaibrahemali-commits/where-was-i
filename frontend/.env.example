# Copy to .env.local for running on your computer, or add these as
# Environment Variables in Vercel. Leave the Supabase lines empty to run the
# app with no accounts (everything stays on the device).

# Supabase → Project Settings → API (or "Connect") → Project URL
VITE_SUPABASE_URL=
# Supabase → the "anon" / "publishable" key. It is public by design; the
# database rules in supabase/setup.sql are what keep each person's data private.
# Never put the "service_role" / "secret" key here.
VITE_SUPABASE_ANON_KEY=

# Link to your public copy of the code (required by the AGPL licence when you host it)
VITE_SOURCE_URL=
